{
	admin unix//run/caddy-admin/admin.sock|0660
	auto_https off

	# Per-site request counters, shown live on the Routes page.
	metrics {
		per_host
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

http://app.localhost:8080 {
	log
	encode gzip
	respond "hello from the dev caddy"
}

http://api.localhost:8080 {
	log
	encode gzip
	respond "an api" 200
}

http://admin.localhost:8080 {
	log
	respond "nothing here" 404
}

http://files.localhost:8081 {
	log
	respond "a second site" 200
}
