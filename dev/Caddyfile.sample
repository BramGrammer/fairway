{
	admin unix//run/caddy-admin/admin.sock|0660
	auto_https off

	# Per-site request counters, shown live on the Routes page.
	metrics {
		per_host
	}

	# Default log: runtime messages plus every host without its own `log` block.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# Public hosts: own JSON log, secrets in the query string are redacted.
(public_log) {
	log public {
		output file /var/log/caddy/access-public.log {
			roll_size 10mb
			roll_keep 5
		}
		format filter {
			wrap json
			request>uri query {
				replace api_key REDACTED
				replace token REDACTED
			}
		}
	}
}

# Internal hosts (custom port 8081): own log, no redaction.
(internal_log) {
	log internal {
		output file /var/log/caddy/access-int.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

http://app.example.test:8080 {
	import public_log
	encode gzip
	respond "hello from the dev caddy"
}

http://api.example.test:8080 {
	import public_log
	encode gzip
	respond "an api" 200
}

# Bare `log`, no name: logs to the default logger, so lines land in access.log.
http://plain.example.test:8080 {
	log
	respond "default log" 200
}

# No `log` block at all. Because another host uses a bare `log`, Caddy lists this host in
# skip_hosts with its port. A request whose Host header has no port still lands in access.log
# (curl with a plain Host), one with the port (a browser) is not logged.
http://quiet.example.test:8080 {
	respond "not logged" 200
}

http://admin.example.test:8081 {
	import internal_log
	respond "internal admin" 200
}

http://files.example.test:8081 {
	import internal_log
	respond "internal files" 200
}
