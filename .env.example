# Compose profile. "local" publishes the editor on EDITOR_BIND:EDITOR_PORT
COMPOSE_PROFILES=local

# --- local profile ---
# 127.0.0.1 keeps it reachable only from the NAS itself (use an SSH tunnel to test).
# Do NOT set 0.0.0.0 unless you accept that there is no login.
EDITOR_BIND=127.0.0.1
EDITOR_PORT=3000

# Caddy's HTTPS address as reachable from the editor container, host or host:port.
# Enables expiry and issuer on the TLS tab. Leave empty to show config-derived info only.
# Use Caddy's LAN address, not a public name (a CDN proxy would answer with its own Certificate).
TLS_PROBE_ADDR=
# Set to 1 to request each host every 5 minutes and report 502/503/504 as down (needs TLS_PROBE_ADDR).
HOST_CHECK=

# Where Fairway sends Alerts through ntfy (a Certificate turning bad, an upstream or Caddy going down, a refused
# Deploy): the full topic address, e.g. https://ntfy.example.test/fairway; several can be separated by commas.
# NTFY_TOKEN is only needed when the topic requires a login. Leave NTFY_URL empty for no Alerts; the history is
# kept either way. PUBLIC_URL makes each message open Fairway when tapped. These are only the defaults: Settings in
# the interface can change them, and what it saves (in DATA_DIR) wins.
NTFY_URL=
NTFY_TOKEN=
PUBLIC_URL=

# The model endpoint for the Assistant and Reviews: any OpenAI-compatible address (OpenRouter by default; OpenAI or a
# local server such as Ollama also work) and its key. Leave AI_BASE_URL empty for OpenRouter. These are only the
# defaults: Settings in the interface can change them, and what it saves (in DATA_DIR) wins. The key is never shown.
# Both features need the login below. The Caddyfile (secrets masked) and log digests go to this endpoint, see the
# README, "What leaves your machine". A local server needs no key; use its LAN address, not localhost.
AI_BASE_URL=
AI_API_KEY=
# The model each task uses, as the endpoint names it. Both need a model that supports tool calling.
AI_ASSISTANT_MODEL=
AI_REVIEW_MODEL=
# How often a Review runs by itself: off, 6h, 12h, 24h or weekly. Empty means 24h. Only a default, like the above.
AI_REVIEW_INTERVAL=

# The Owner's login. Set AUTH_USER plus AUTH_PASSWORD (or AUTH_PASSWORD_HASH, see the README) to require
# a login. Leave all empty to run without one, on a network you already restrict.
AUTH_USER=
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
# Caddy's address (comma separated IPs or CIDRs) when Fairway sits behind it, so the visitor's address is read
# from X-Forwarded-For. Leave empty otherwise.
TRUST_PROXY=

# Which published image to run: latest, a version like 1.0.0, or a commit like sha-1a2b3c4
FAIRWAY_TAG=latest

# --- paths on the NAS (the Caddy stack's folders) ---
# The folder of your Caddy stack, containing caddy/CaddyFile, caddy/admin and logs/
CADDY_STACK_DIR=/path/to/dockge/stacks/caddy
