# Which way to reach the editor. Use ONE of: local, tailscale
#   local     - publishes the editor on EDITOR_BIND:EDITOR_PORT, no Tailscale needed
#   tailscale - starts the Tailscale sidecar, publishes no port
COMPOSE_PROFILES=local

# --- local profile ---
# 127.0.0.1 keeps it reachable only from the NAS itself (use an SSH tunnel to test).
# Do NOT set 0.0.0.0 unless you accept that there is no login.
EDITOR_BIND=127.0.0.1
EDITOR_PORT=3000

# --- tailscale profile ---
# Reusable auth key tagged tag:fairway (Tailscale admin console > Settings > Keys)
TS_AUTHKEY=
# Only this Tailscale login may use the editor
TS_ALLOWED_LOGIN=you@example.com

# --- paths on the NAS (the Caddy stack's folders) ---
CADDY_STACK_DIR=/path/to/dockge/stacks/caddy
